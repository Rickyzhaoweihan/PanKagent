{
  "type": "object",
  "required": [
    "schema",
    "library",
    "providers",
    "gpu_participation_required"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": {
        "id": "kg-agent.query-patterns",
        "version": "2.0.0"
      }
    },
    "library": {
      "type": "object",
      "required": [
        "version",
        "graph_release",
        "rules"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string"
        },
        "graph_release": {
          "type": "string"
        },
        "rules": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "guidance": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "relations": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "required_paths": {
                    "items": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "id",
                  "relations",
                  "required_paths",
                  "guidance"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "guidance": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "relations": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "required_paths": {
                    "items": {},
                    "type": "array"
                  }
                },
                "required": [
                  "id",
                  "relations",
                  "required_paths",
                  "guidance"
                ],
                "type": "object"
              }
            ]
          }
        },
        "template_topology_routes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "template_id",
              "node_types",
              "edges",
              "required_identity_types",
              "required_predicate_types"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "template_id": {
                "type": "string",
                "minLength": 1
              },
              "node_types": {
                "type": "array",
                "minItems": 2,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "edges": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "target",
                    "relation"
                  ],
                  "properties": {
                    "source": {
                      "type": "string",
                      "minLength": 1
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1
                    },
                    "relation": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "required_identity_types": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required_predicate_types": {
                "type": "array",
                "minItems": 1,
                "maxItems": 7,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "required": [
        "neo4j",
        "postgresql"
      ],
      "additionalProperties": false,
      "properties": {
        "neo4j": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "postgresql": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gpu_participation_required": {
      "type": "boolean"
    },
    "referenced_dependency_entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "source_relation",
          "source_property",
          "entity_type",
          "id_pattern",
          "max_ids"
        ],
        "properties": {
          "relation": {
            "type": "string"
          },
          "source_relation": {
            "type": "string"
          },
          "source_property": {
            "type": "string"
          },
          "entity_type": {
            "type": "string"
          },
          "id_pattern": {
            "type": "string"
          },
          "max_ids": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          }
        }
      }
    },
    "interval_overlap_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "anchor",
          "member",
          "context",
          "relation",
          "chromosome",
          "assembly",
          "start",
          "end",
          "request_pattern",
          "guidance"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "anchor": {
            "type": "string"
          },
          "member": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "chromosome": {
            "type": "string"
          },
          "assembly": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "request_pattern": {
            "type": "string"
          },
          "guidance": {
            "type": "string"
          }
        }
      }
    },
    "clinical_retrieval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population_type": {
          "type": "string"
        },
        "sample_type": {
          "type": "string"
        },
        "sample_relation": {
          "type": "string"
        },
        "diagnosis_relation": {
          "type": "string"
        },
        "ranking_stage": {
          "type": "string"
        },
        "complete": {
          "const": true
        },
        "diagnosis_type": {
          "type": "string"
        },
        "template_fields": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "population_type",
        "sample_type",
        "sample_relation",
        "diagnosis_relation",
        "complete",
        "ranking_stage"
      ]
    },
    "coordinate_lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_type",
        "result_type",
        "anchor_mapping",
        "result_mapping",
        "sql_schema"
      ],
      "properties": {
        "anchor_type": {
          "type": "string"
        },
        "result_type": {
          "type": "string"
        },
        "anchor_mapping": {
          "type": "string"
        },
        "result_mapping": {
          "type": "string"
        },
        "sql_schema": {
          "type": "string"
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
