  "application_overrides": {
    "version": "full-record-facts-v1",
    "source_review": "2026-09-19",
    "rules": [
      "Aggregate cohort answers omit unrequested individual clinical data.",
      "Clinical stage is recorded metadata; original definitions are preserved in upstream, not supplied as active clinical criteria.",
      "GO evidence code expansions and category distinctions follow official GO documentation.",
      "Model-context omissions do not imply missing database metadata.",
      "Separate QTL indexed relationships from credible-set width, phenotype type and unreturned posterior probabilities.",
      "Matched cell-type counts do not establish the total number profiled by a source study; missing fGSEA contrast is explicitly distinguished from statistical direction.",
      "Full-record fact ledgers preserve source-specific signal roles, assay/method distributions and exact GO expansions without speculative artifact caveats.",
      "QTL source labels do not establish molecular subtype; distinct credible_set record identifiers do not prove independent signals or exclude shared biology, and complete recorded IDs are never described as unnamed."
    ],
    "sources": [
      "https://geneontology.org/docs/guide-go-evidence-codes/"
    ],
    "verified_factual_blocks": {
      "version": "1.10.0",
      "reason": "Validate canonical factual blocks before display; preserve assay/entity/counting roles; no unrecorded hormone, cognate-cell, artifact or threshold assurances."
    },
    "readability": {
      "version": "1.10.1",
      "reason": "Plain-language uncertainty, readable field labels and citation-preserving deduplication; no change to evidence or provider."
    }
  },
