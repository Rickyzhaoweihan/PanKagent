        <mxCell id="NYkV4tobwIVgV4ygGFPI-4" value="&lt;b style=&quot;text-align: center;&quot;&gt;D01 Preliminary assessment&lt;/b&gt;&lt;br style=&quot;text-align: center;&quot;&gt;&lt;span style=&quot;text-align: center; font-size: 14px;&quot;&gt;PYTHON · advisory only&lt;br&gt;resolved / ambiguous / not found / unavailable&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;text-align: center; font-size: 14px;&quot;&gt;&lt;font style=&quot;color: rgb(255, 30, 30);&quot;&gt;E01:&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; font-size: 14px;&quot;&gt;&lt;font color=&quot;#ff1e1e&quot;&gt;&amp;nbsp;Grounding/lookup unavailable; non-blocking&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontSize=18;fontColor=#203344;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1" schema_modules="1,4" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
