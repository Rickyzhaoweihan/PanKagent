        </mxCell>
        <mxCell id="claude-tools" value="&lt;b&gt;M04 tool · facts, advice + diagnostics&lt;/b&gt;&lt;br&gt;Facts: IDs, values, owners + topology&lt;br&gt;Advice: interpretations, paths + identity drafts&lt;br&gt;Verified identity can recover a plain introduction&lt;br&gt;Actual filters and validation remain mandatory&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:13px&quot;&gt;E03 advisory / E04 execution checks&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1–4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: claude-sonnet-5-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontSize=18;fontColor=#203344;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1" tooltip="E03 is non-blocking advice. Claude links request wording to verified typed IDs; lexical matching cannot veto interpretation. Existing execution checks remain. Shared Schemas 1–4. Verified facts include database identities, recorded values, ownership, topology and provenance. Interpretation and candidate paths are advisory. Claude may discard irrelevant guidance; execution, binding and completeness checks remain authoritative. Draft dispositions are recorded by rule ID. A disease mention alone does not require donor retrieval; useful optional context is model-directed. Missing Python wording-authorization proof is advisory for a predicate explicitly selected by Claude in record_plan. Stored IDs, property ownership, read-only execution and dependency connectivity remain verified." diagnostic_family="E03" schema_modules="1–4">
          <mxGeometry x="1435" y="1125" width="470" height="210" as="geometry" />
        </mxCell>
        <mxCell id="claude-clarify" value="ask user" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=16;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="scope" target="clarify">
          <mxGeometry relative="1" as="geometry">
