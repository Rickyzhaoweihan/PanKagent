        <mxCell id="claude-stage" value="&lt;b&gt;LLM API supervisor · 3 proposals + 2 lookup turns; 2 execution repairs (7 calls total)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf6ff;strokeColor=#8961b0;strokeWidth=2;fontSize=15;fontColor=#203344;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="810" y="1070" width="1135" height="520" as="geometry" />
        </mxCell>
        <mxCell id="title" value="&lt;b&gt;PanKagent • I/O orchestration and decision points&lt;/b&gt;&lt;br&gt;Entry → entity resolution → scope/planning → execution mode → readiness → independent answer and viewer inputs&lt;br&gt;Targeted fixes deployed · 2026-10-03 · Introduction candidate remains inactive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=23;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="30" y="20" width="2340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="in" value="&lt;b&gt;M01  Question + session&lt;/b&gt;&lt;br&gt;IN: raw question, history, preferences&lt;br&gt;Pin code / pack / database / model versions&lt;br&gt;OUT: immutable request + run context&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="1" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="1050" y="260" width="430" height="150" as="geometry" />
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="rev" target="ground">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-5" value="&lt;span style=&quot;color: rgb(38, 62, 82); font-size: 17px;&quot;&gt;user modified&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(38, 62, 82); font-size: 17px;&quot;&gt;question&lt;/span&gt;&lt;/div&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="nJrK4v0Pw7rqCHPKsujb-4">
          <mxGeometry x="-0.1012" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rev" value="&lt;b&gt;M02  Revision interpreter&lt;/b&gt;&lt;br&gt;&lt;b&gt;IN:&lt;/b&gt; previous question + change&lt;br&gt;OUT: one standalone question&lt;br&gt;Chain change: restart; parallel: extend&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,3&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="1,3" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="1730" y="517.5" width="470" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ground" value="&lt;b&gt;M03  PYTHON ENTITY LOOKUP&lt;/b&gt;&lt;br&gt;Names + synonyms → verified candidates&lt;br&gt;Phrase matches are advice, not required filters&lt;br&gt;LLM API interprets roles before compilation&lt;br&gt;All statuses continue; no rejection gate&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="1" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="980" y="490" width="570" height="215" as="geometry" />
        </mxCell>
        <mxCell id="NYkV4tobwIVgV4ygGFPI-1" value="ALWAYS continue · every status" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="NYkV4tobwIVgV4ygGFPI-4" target="claude-stage">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1265" y="1010" as="sourcePoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-6" value="&lt;span style=&quot;color: rgb(38, 62, 82); font-size: 17px;&quot;&gt;user accepts / edits correction&lt;/span&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="clarify" target="rev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="clarify" value="&lt;b&gt;M03a  LLM API-requested clarification&lt;/b&gt;&lt;br&gt;Only when context does not settle the ambiguity&lt;br&gt;Specific alternatives + one complete question&lt;br&gt;Non-exact choice may proceed with a clear warning&lt;br&gt;User accepts / edits → M02 → M03&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,3,4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: claude-sonnet-5-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="1,3,4" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="1715" y="802.5" width="500" height="215" as="geometry" />
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="plan" target="scope">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-13" value="&lt;span style=&quot;color: rgb(38, 62, 82); font-size: 17px;&quot;&gt;prepared task&lt;/span&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="nJrK4v0Pw7rqCHPKsujb-12">
          <mxGeometry x="-0.0039" y="-1" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="plan" value="&lt;b&gt;M04  LLM API interpretation + planning + repair&lt;/b&gt;&lt;br&gt;Raw request → anchors / filters / examples&lt;br&gt;Background + requested output stay distinct&lt;br&gt;Phrase heuristics advise; LLM API decides meaning&lt;br&gt;3 proposals; 2 lookup batches × 6 requests&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:13px&quot;&gt;E02 plan / E04 preparation diagnostics&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1–4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: claude-sonnet-5-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" tooltip="Request authority: server-owned original_raw_question, current_raw_input, revision_instruction and effective_question accompany every Claude call, including repair and answer input. Latest explicit edits override superseded scope. Python drafts and suggestions add no user requirements. No extra model call. Related GWAS exploration is useful context for QTL questions. Keep direct evidence primary; a simple disease definition should not become a large donor-only investigation." diagnostic_family="E02" schema_modules="1–4">
          <mxGeometry x="835" y="1120" width="580" height="215" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;D02  LLM API&lt;br&gt;semantic decision&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Examples ≠ filters&lt;br&gt;Keep actual constraints&lt;/span&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 3,4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: claude-sonnet-5-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=16;align=left;verticalAlign=top;spacing=18;arcSize=8;shape=rhombus;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1" decision_engine="Claude" decision_basis="Model interpretation using original wording and verified lookup candidates; Python still verifies execution." decision_source="planning_session.py" tooltip="E03 is non-blocking advice. Claude links request wording to verified typed IDs; lexical matching cannot veto interpretation. Existing execution checks remain. D02 is the semantic decision within the existing record_plan turn. The accepted plan selects relevant entities, requested relationships and optional context. Python preparation cannot restore omitted donor suggestions. Latest explicit revisions take precedence; factual execution checks remain mandatory. Claude-selected predicates retain a server-recorded decision tied to the current request and task. Later helper-added predicates cannot inherit this authority. Related GWAS exploration is useful context for QTL questions. Keep direct evidence primary; a simple disease definition should not become a large donor-only investigation." schema_modules="3,4">
          <mxGeometry x="985" y="1380" width="280" height="190" as="geometry" />
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-20" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="partialscope" target="recover">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-22" value="None" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="nJrK4v0Pw7rqCHPKsujb-20">
          <mxGeometry x="-0.0815" y="-3" relative="1" as="geometry">
            <mxPoint y="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-23" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;None&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="nJrK4v0Pw7rqCHPKsujb-20">
          <mxGeometry x="-0.042" y="-3" relative="1" as="geometry">
            <mxPoint y="1" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="partialscope" value="&lt;b&gt;M04R  Planning repair exhausted&lt;/b&gt;&lt;br&gt;Keep verified independent work + unmet checks&lt;br&gt;Invalidate descendants of a changed task&lt;br&gt;No exhaustive count from incomplete retrieval&lt;br&gt;No usable evidence → targeted recovery&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="4" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters. Preserve server-prepared natural-language recovery after retries; show verified revision choices instead of replacing them with generic E04 text.">
          <mxGeometry x="665" y="1970" width="500" height="215" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="&lt;b&gt;D3  Which execution mode?&lt;/b&gt;&lt;br&gt;Parallel / chain / mixed task DAG&lt;br&gt;LLM API proposes; PYTHON schedules&lt;br&gt;Verified IDs / paths bind dependent tasks&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 2,4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: claude-sonnet-5-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" decision_engine="Python (deterministic)" decision_basis="Python computes execution_mode from depends_on/path_spec and independent tasks. Claude or verified local patterns propose the plan; Python classifies it as parallel, chain or mixed." decision_source="composable_planning.py: normalize; planning_contract.py; pattern_planning.py" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." schema_modules="2,4">
          <mxGeometry x="1325" y="1970" width="550" height="205" as="geometry" />
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-24" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="exec" target="ready">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="nJrK4v0Pw7rqCHPKsujb-25" value="&lt;span style=&quot;color: rgb(38, 62, 82); font-size: 17px;&quot;&gt;outcomes&lt;/span&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="nJrK4v0Pw7rqCHPKsujb-24">
          <mxGeometry x="-0.0444" y="-2" relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="exec" value="&lt;b&gt;M06–M09  Supervised task execution&lt;/b&gt;&lt;br&gt;Zero or more genuine filters; normal validation&lt;br&gt;Graph records or scalar rows → PYTHON combine&lt;br&gt;LLM API: bounded repair; task-local failures&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,2,4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: claude-sonnet-5-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="1,2,4" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="1325" y="2270" width="550" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;D4  Usable verified evidence?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#245b40&quot;&gt;&lt;b&gt;PYTHON · evidence checks&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:14px&quot;&gt;E09: Evidence not ready&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 3,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;shape=rhombus;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1" decision_engine="Python (deterministic)" decision_basis="Python query_readiness checks preparation, verified required outcomes, terminal statuses, scope/resource guards and the partial-independent policy. It is not a Claude judgment." decision_source="evidence_status.py: query_readiness" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." diagnostic_family="E09" schema_modules="3,4">
          <mxGeometry x="1420" y="2530" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="recover" value="&lt;b&gt;M10a  Recovery / clarification&lt;/b&gt;&lt;br&gt;No useful verified result or invalid dependencies&lt;br&gt;Report failed validation; preserve wording&lt;br&gt;Retry / revise / cancel; no absence claim&lt;br&gt;No added path condition; retain audit history&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 3,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ed;strokeColor=#ba5750;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="3,4" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="630" y="2530" width="570" height="200" as="geometry" />
        </mxCell>
        <mxCell id="preview" value="&lt;b&gt;M10  Preview + user confirmation&lt;/b&gt;&lt;br&gt;Complete OR partial evidence + limitations&lt;br&gt;Confirm → keep checked result snapshot&lt;br&gt;Revise → M02; cancel → stop&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 3,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="3,4" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="1355" y="2820" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="answer" value="&lt;b&gt;M11  Answer input → M12 Formatting&lt;/b&gt;&lt;br&gt;PYTHON counts + full-record facts → LLM API wording&lt;br&gt;Interpret scope hints; evidence + G citations&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:14px&quot;&gt;E10: Answer generation failed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: claude-sonnet-5-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters. The program first measures returned evidence size. Only an oversized query activates a maximum of 100 illustrative records per collection; byte budgets may retain fewer. LLM metadata records the trigger, measured bytes, budget and sampling warning. Full backend populations and completeness remain unchanged; short parallel evidence is not downgraded. M12 has an independent bounded writing deadline; answer prefixes and SSE deltas commit together." diagnostic_family="E10" schema_modules="1,4">
          <mxGeometry x="885" y="3090" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="viewer" value="&lt;b&gt;M13  Independent viewer evidence&lt;/b&gt;&lt;br&gt;Useful selected graph records + exact-ID hydration&lt;br&gt;Can retain more detail than the answer input&lt;br&gt;viewer_evidence.py → results service 8795&lt;br&gt;Excluded populations cannot reappear as answers&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,2&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="1,2" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="1655" y="3090" width="700" height="170" as="geometry" />
        </mxCell>
