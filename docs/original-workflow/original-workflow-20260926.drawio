        </mxCell>
        <mxCell id="tK93tzaCFONGBUCUjE4C-45" value="&lt;b&gt;D7 Candidate route?&lt;/b&gt;&lt;br&gt;PYTHON dispatch / LLM API repair&lt;br&gt;Verified cache/template first; GPU fallback&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,2,4&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: claude-sonnet-5-5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1" decision_engine="Python (deterministic)" decision_basis="Python chooses ordered routes using cache/template availability, path/local-coloc restrictions, configuration and the GPU-participation flag. GPU or Claude may generate/repair candidates; they do not choose this route." decision_source="graph.py: candidate route selection; candidate_policy.py" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." schema_modules="1,2,4">
          <mxGeometry x="2425" y="980" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tK93tzaCFONGBUCUjE4C-46" value="&lt;b&gt;M06a • local candidate&lt;/b&gt;&lt;br&gt;Same-sample template; keep filters&lt;br&gt;True path tasks retain path roles&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,2&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1" schema_modules="1,2" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="2840" y="930" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tK93tzaCFONGBUCUjE4C-47" value="&lt;b&gt;M06b • GPU Cypher API&lt;/b&gt;&lt;br&gt;Task + schema + actual required scope&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:14px&quot;&gt;E05: Query generation failed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,2,3&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#5B2C83&quot; style=&quot;font-size:11px&quot;&gt;Model: Qwen/Qwen3.8-27B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0d9;strokeColor=#bd7b20;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." diagnostic_family="E05" schema_modules="1,2,3">
          <mxGeometry x="2840" y="1110" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tK93tzaCFONGBUCUjE4C-48" value="&lt;b&gt;D8  Common validation passes?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#245b40&quot;&gt;&lt;b&gt;PYTHON · read-only, schema, bindings + EXPLAIN&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:14px&quot;&gt;E06: Query validation failed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;shape=rhombus;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1" decision_engine="Python (deterministic)" decision_basis="Python validates Cypher read-only/schema rules, required predicates, parameter authorization and dependency bindings. The candidate may be GPU-, Claude-, or template-generated, but acceptance is deterministic." decision_source="graph.py: validate_cypher; semantic_registry.py: validation_errors" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." diagnostic_family="E06" schema_modules="1,4">
