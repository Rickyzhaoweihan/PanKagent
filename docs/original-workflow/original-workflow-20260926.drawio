        <mxCell id="legend" value="&lt;b&gt;Legend / reading order&lt;/b&gt;&lt;br&gt;Solid arrows = control or data flow.&amp;nbsp;&lt;div&gt;Dashed arrows = policy/reference input.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Diamonds = decisions.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Green: code&lt;/div&gt;&lt;div&gt;Purple: LLM API&lt;/div&gt;&lt;div&gt;Orange: GPU&amp;nbsp;&lt;/div&gt;&lt;div&gt;Teal: data&amp;nbsp;&lt;/div&gt;&lt;div&gt;Yellow: schema references&amp;nbsp;&lt;/div&gt;&lt;div&gt;Red: failure/gap&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
