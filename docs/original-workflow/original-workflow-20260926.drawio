        <mxCell id="tK93tzaCFONGBUCUjE4C-50" value="&lt;b&gt;Backend task outcome&lt;/b&gt;&lt;br&gt;complete / empty / partial / failed&lt;br&gt;Full records or complete category values&lt;br&gt;Feeds scheduler / M09; never samples&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1" schema_modules="4" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
