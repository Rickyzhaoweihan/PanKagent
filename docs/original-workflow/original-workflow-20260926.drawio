        </mxCell>
        <mxCell id="tK93tzaCFONGBUCUjE4C-49" value="&lt;b&gt;M08 • Neo4j read&lt;/b&gt;&lt;br&gt;Parameters → graph records / scalar rows&lt;br&gt;Completion, endpoint + path checks&lt;br&gt;Same limits; no racing replacement&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:13px&quot;&gt;E07 retrieval failed / incomplete&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." diagnostic_family="E07" schema_modules="1">
