        <mxCell id="exec" value="&lt;b&gt;M06–M09  Supervised task execution&lt;/b&gt;&lt;br&gt;PYTHON: dispatch / validate / read / combine&lt;br&gt;CLAUDE: bounded query correction&lt;br&gt;Full backend IDs; task-local failure states&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,2,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="2,5,6" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="1325" y="2270" width="550" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="&lt;b&gt;D4  Usable verified
evidence?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#245b40&quot;&gt;&lt;b&gt;PYTHON · evidence checks&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:14px&quot;&gt;E09: Evidence not ready&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 3,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;shape=rhombus;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1" decision_engine="Python (deterministic)" decision_basis="Python query_readiness checks preparation, verified required outcomes, terminal statuses, scope/resource guards and the partial-independent policy. It is not a Claude judgment." decision_source="evidence_status.py: query_readiness" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." diagnostic_family="E09" schema_modules="4,6">
          <mxGeometry x="1420" y="2530" width="360" height="200" as="geometry" />
        </mxCell>
        <mxCell id="recover" value="&lt;b&gt;M10a  Recovery / clarification&lt;/b&gt;&lt;br&gt;No useful verified result or invalid dependencies&lt;br&gt;Specific failed condition + corrected question&lt;br&gt;Retry / revise / cancel; no absence claim&lt;br&gt;Keep original request and audit history&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 3,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ed;strokeColor=#ba5750;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="4,6" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="630" y="2530" width="570" height="200" as="geometry" />
        </mxCell>
        <mxCell id="preview" value="&lt;b&gt;M10  Preview + user confirmation&lt;/b&gt;&lt;br&gt;Complete OR partial evidence + limitations&lt;br&gt;Confirm → keep checked result snapshot&lt;br&gt;Revise → M02; cancel → stop&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 3,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="4,6" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
          <mxGeometry x="1355" y="2820" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="answer" value="&lt;b&gt;M11  Answer input → M12 Formatting&lt;/b&gt;&lt;br&gt;Per query: full OR identity-only evidence&lt;br&gt;Verified summaries / paths + G citations&lt;br&gt;Existing Claude writing / streaming unchanged&lt;br&gt;format_input_modes.py / evidence_context.py&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:14px&quot;&gt;E10: Answer generation failed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." diagnostic_family="E10" schema_modules="2,6">
          <mxGeometry x="885" y="3090" width="640" height="170" as="geometry" />
        </mxCell>
        <mxCell id="viewer" value="&lt;b&gt;M13  Independent viewer evidence&lt;/b&gt;&lt;br&gt;Useful selected graph records + exact-ID hydration&lt;br&gt;Can retain more detail than the answer input&lt;br&gt;viewer_evidence.py → results service 8795&lt;br&gt;Excluded populations cannot reappear as answers&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,2&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="2,5" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
