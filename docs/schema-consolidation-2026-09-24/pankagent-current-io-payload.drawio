  <diagram name="02 Chain parallel mixed" id="page1">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="2400" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;PanKagent • three execution modes, one shared query unit&lt;/b&gt;&lt;br&gt;M06 scheduler is dependency-driven: ready tasks run; children wait for verified backend inputs; failed branches stay explicit&lt;br&gt;Documented dev snapshot: 2026-09-23 • discovery-gate-fdfd005 • module IDs are cross-page references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=23;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="30" y="20" width="2340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="parallel" value="&lt;b&gt;PARALLEL • independent evidence&lt;/b&gt;&lt;br&gt;No data dependency between queries.&lt;br&gt;Retain each branch; combine only when requested." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=22;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="50" y="175" width="680" height="135" as="geometry" />
        </mxCell>
        <mxCell id="chain" value="&lt;b&gt;CHAIN • connected subtasks&lt;/b&gt;&lt;br&gt;A → B → C; each next task consumes typed IDs.&lt;br&gt;Fragments can compose beyond four node types." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=22;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="860" y="175" width="680" height="135" as="geometry" />
        </mxCell>
        <mxCell id="mixed" value="&lt;b&gt;MIXED / COMPLEX • task DAG&lt;/b&gt;&lt;br&gt;Chains and independent branches coexist.&lt;br&gt;Only a task’s required parents control its readiness." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=22;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="1670" y="175" width="680" height="135" as="geometry" />
        </mxCell>
        <mxCell id="pa" value="&lt;b&gt;Q1 • independent&lt;/b&gt;&lt;br&gt;Run query unit U&lt;br&gt;Return backend R1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="80" y="370" width="280" height="130" as="geometry" />
