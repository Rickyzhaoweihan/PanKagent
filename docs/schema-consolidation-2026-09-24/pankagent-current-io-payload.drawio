        <mxCell id="tK93tzaCFONGBUCUjE4C-7" value="&lt;b&gt;D5  Branch outcomes?&lt;/b&gt;&lt;br&gt;Complete / empty / partial / failed&lt;br&gt;Failed sibling ≠ empty set&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#245b40&quot;&gt;&lt;b&gt;PYTHON · result statuses&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1" decision_engine="Python (deterministic)" decision_basis="Python reads branch execution and validation statuses, retaining successful independent evidence and explicit failed or incomplete outcomes. No model evaluates the branch status." decision_source="composable_planning.py; evidence_status.py" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." schema_modules="6">
