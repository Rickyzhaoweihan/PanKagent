        <mxCell id="route" value="&lt;b&gt;D7  Query route?&lt;/b&gt;&lt;br&gt;Supported structure / cache?&lt;br&gt;GPU participation required?&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#245b40&quot;&gt;&lt;b&gt;PYTHON · route policy&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" decision_engine="Python (deterministic)" decision_basis="Python chooses ordered routes using cache/template availability, path/local-coloc restrictions, configuration and the GPU-participation flag. GPU or Claude may generate/repair candidates; they do not choose this route." decision_source="graph.py: candidate route selection; candidate_policy.py" tooltip="Python chooses ordered routes using cache/template availability, path/local-coloc restrictions, configuration and the GPU-participation flag. GPU or Claude may generate/repair candidates; they do not choose this route. Source: graph.py: candidate route selection; candidate_policy.py">
          <mxGeometry x="55" y="1420" width="330" height="150" as="geometry" />
        </mxCell>
        <mxCell id="local" value="&lt;b&gt;M06a • local candidate&lt;/b&gt;&lt;br&gt;Template / verified cache&lt;br&gt;query_templates.py / bounded_paths.py" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
