        <mxCell id="legend" value="&lt;b&gt;Legend / reading order&lt;/b&gt;&lt;br&gt;Solid arrows = control or data flow.&amp;nbsp;&lt;div&gt;Dashed arrows = policy/reference input.&amp;nbsp;&lt;/div&gt;&lt;div&gt;Diamonds = decisions.&amp;nbsp;&lt;br&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Green: code&lt;/div&gt;&lt;div&gt;Purple: Claude&lt;/div&gt;&lt;div&gt;Orange: GPU&amp;nbsp;&lt;/div&gt;&lt;div&gt;Teal: data&amp;nbsp;&lt;/div&gt;&lt;div&gt;Dashed yellow: proposed registry&amp;nbsp;&lt;/div&gt;&lt;div&gt;Red: failure/gap&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="100" y="2162.4" width="440" height="395.2" as="geometry" />
        </mxCell>
        <mxCell id="tK93tzaCFONGBUCUjE4C-1" value="&lt;b&gt;PanKagent • three execution modes, one shared query unit&lt;/b&gt;&lt;br&gt;M06 scheduler is dependency-driven: ready tasks run; children wait for verified backend inputs; failed branches stay explicit&lt;br&gt;Schema consolidation candidate · 2026-09-24 · protected tabs unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=23;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="2420" y="1770" width="2340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="tK93tzaCFONGBUCUjE4C-2" value="&lt;b&gt;PARALLEL • independent evidence&lt;/b&gt;&lt;br&gt;No data dependency between queries.&lt;br&gt;Retain each branch; combine only when requested." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=22;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="2440" y="1925" width="680" height="135" as="geometry" />
        </mxCell>
        <mxCell id="tK93tzaCFONGBUCUjE4C-3" value="&lt;b&gt;CHAIN • connected subtasks&lt;/b&gt;&lt;br&gt;A → B → C; each next task consumes typed IDs.&lt;br&gt;Fragments can compose beyond four node types." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=22;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1">
