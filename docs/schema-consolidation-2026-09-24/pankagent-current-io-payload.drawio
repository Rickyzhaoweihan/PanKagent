        <mxCell id="claude-stage" value="&lt;b&gt;Claude supervisor · 3 proposals + 2 lookup turns; 2 execution repairs (7 calls total)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#faf6ff;strokeColor=#8961b0;strokeWidth=2;fontSize=15;fontColor=#203344;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
