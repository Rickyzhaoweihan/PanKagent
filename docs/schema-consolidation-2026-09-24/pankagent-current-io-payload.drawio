  <diagram name="03 Payload by mode" id="page2">
    <mxGraphModel dx="1048" dy="1619" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;PanKagent • payload flow, typed dependencies and evidence separation&lt;/b&gt;&lt;br&gt;Illustrative payload shapes; not newly executed biological results. Computation always precedes formatter compaction.&lt;br&gt;Documented dev snapshot: 2026-09-23 • discovery-gate-fdfd005 • module IDs are cross-page references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=23;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="30" y="20" width="2340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="r" value="&lt;b&gt;P1 • effective request [M01–M02]&lt;/b&gt;&lt;br&gt;question + immutable raw wording&lt;br&gt;session_id / revision / preferences&lt;br&gt;history; parent_run_id when applicable&lt;br&gt;Revision output: new_question + restart/extend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="190" width="500" height="195" as="geometry" />
        </mxCell>
        <mxCell id="g" value="&lt;b&gt;P2 • entity resolution [M03]&lt;/b&gt;&lt;br&gt;mentions → typed candidate IDs + owner roles&lt;br&gt;graph_release; inventory/schema provenance&lt;br&gt;status: ready / ambiguous / unavailable&lt;br&gt;original_requested ↔ canonical value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="670" y="190" width="570" height="195" as="geometry" />
        </mxCell>
        <mxCell id="p" value="&lt;b&gt;P3 • prepared plan [M04–M05]&lt;/b&gt;&lt;br&gt;execution_mode; steps[]; depends_on[]; input_bindings[]; path_spec&lt;br&gt;constraints + request_filter_bindings + resolved_entities + resolution_key&lt;br&gt;combine_operations[]; answer_step_ids[]; per-query context_mode&lt;br&gt;Keep authorization provenance distinct from operational routing flags" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="1370" y="190" width="960" height="195" as="geometry" />
        </mxCell>
        <mxCell id="edge1" value="resolve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="r" target="g" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge2" value="compile scope" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="g" target="p" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="parallel" value="&lt;b&gt;PARALLEL payload&lt;/b&gt;&lt;br&gt;Q1 {depends_on: []} → R1&lt;br&gt;Q2 {depends_on: []} → R2&lt;br&gt;&lt;br&gt;R1 and R2 retain separate query provenance.&lt;br&gt;combine {op: intersection, inputs: [R1,R2],&lt;br&gt;  entity_type: donor, key: id} when requested.&lt;br&gt;&lt;br&gt;No declared join → preserve both evidence categories.&lt;br&gt;Narrow: predicate IDs / verified local filter.&lt;br&gt;Widen: retrieve revised population; not only old IDs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="500" width="690" height="430" as="geometry" />
        </mxCell>
        <mxCell id="chain" value="&lt;b&gt;CHAIN payload&lt;/b&gt;&lt;br&gt;Q1 → R1 {typed_ids, path_tuples, completeness}&lt;br&gt;Q2 {depends_on: [Q1],&lt;br&gt; input_bindings: [{step_id: Q1, entity_type: donor,&lt;br&gt; source_role: ..., target_role: source}]}&lt;br&gt;&lt;br&gt;Q2 parameters bind full verified parent IDs.&lt;br&gt;R2 returns connected ordered role/ID tuples.&lt;br&gt;Q3+ extends paths on the exact shared roles.&lt;br&gt;&lt;br&gt;Unknown / failed parent ≠ empty or unrestricted input." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="855" y="500" width="690" height="430" as="geometry" />
        </mxCell>
        <mxCell id="mixed" value="&lt;b&gt;MIXED / COMPLEX payload&lt;/b&gt;&lt;br&gt;Q1 → Q2 uses typed dependency binding.&lt;br&gt;QX {depends_on: []} runs independently.&lt;br&gt;&lt;br&gt;join {inputs: [R2,RX], roles/keys: explicit} only&lt;br&gt;if the question requires that join.&lt;br&gt;&lt;br&gt;Selected outputs + separate supporting evidence.&lt;br&gt;Completeness is inherited from required inputs.&lt;br&gt;A failed Q2 does not erase valid RX.&lt;br&gt;RX alone cannot establish the failed chain relation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#477dac;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="1670" y="500" width="660" height="430" as="geometry" />
        </mxCell>
        <mxCell id="edge3" value="mode = parallel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p" target="parallel" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1514" y="445" />
              <mxPoint x="385" y="445" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge4" value="mode = chain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p" target="chain" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1850" y="460" />
              <mxPoint x="1200" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge5" value="mode = mixed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=0.83;exitY=1;entryX=0.5;entryY=0;" parent="1" source="p" target="mixed" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="backend" value="&lt;b&gt;P4 • backend result contract [M08]&lt;/b&gt;&lt;br&gt;result/step reference; graph release; stable G citation; Cypher + parameters&lt;br&gt;typed IDs; nodes / edges / rows; ordered role/ID path tuples; provenance&lt;br&gt;status: complete / empty / partial / failed; error; requested_scope&lt;br&gt;retrieval_execution: completed / cursor_exhausted / truncated&lt;br&gt;These full records drive counts, chaining, joins and filters." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="1070" width="1010" height="240" as="geometry" />
        </mxCell>
        <mxCell id="combine" value="&lt;b&gt;P5 • verified result projection [M09–M10]&lt;/b&gt;&lt;br&gt;Selected IDs / supporting records + recomputed verified summaries&lt;br&gt;Parent references; join roles and keys; final requested filter coverage&lt;br&gt;Answer steps separated from inspectable intermediate history&lt;br&gt;coloc linkage: exact signal IDs ↔ GWAS/QTL credible sets + context&lt;br&gt;Readiness: complete / partial_ready / recovery; explicit unmet conditions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="1250" y="1070" width="1080" height="240" as="geometry" />
        </mxCell>
        <mxCell id="edge6" value="R1 / R2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="parallel" target="backend" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge7" value="path results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" parent="1" source="chain" target="backend" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1200" y="990" />
              <mxPoint x="848" y="990" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge8" value="DAG results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" parent="1" source="mixed" target="combine" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge9" value="full backend inputs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="backend" target="combine" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mode" value="&lt;b&gt;D10  Per-query&#xa;context size / policy?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2bf;strokeColor=#a57b00;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;shape=rhombus;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="1340" y="1410" width="410" height="180" as="geometry" />
        </mxCell>
        <mxCell id="full" value="&lt;b&gt;P6a • short query: FULL&lt;/b&gt;&lt;br&gt;Relationships, measurements, rows&lt;br&gt;Scope + citations + completeness&lt;br&gt;Richness ≠ exhaustive retrieval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="1440" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;P6b • long query: IDENTITY ONLY&lt;/b&gt;&lt;br&gt;Node IDs / types / descriptions / sources&lt;br&gt;Chain: verified ordered paths + relation types&lt;br&gt;Explicit sampling / omissions; verified counts&lt;br&gt;No omitted quantitative claims" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="700" y="1650" width="650" height="200" as="geometry" />
        </mxCell>
        <mxCell id="viewer" value="&lt;b&gt;P7 • viewer evidence [M13]&lt;/b&gt;&lt;br&gt;Independent selection of useful graph data&lt;br&gt;Full selected backend IDs → hydration&lt;br&gt;Can include detail absent from P6&lt;br&gt;Keep provenance and graph membership&lt;br&gt;No computation from formatter samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="1850" y="1450" width="480" height="245" as="geometry" />
        </mxCell>
        <mxCell id="envelope" value="&lt;b&gt;P6 • formatter envelope [M11–M12]&lt;/b&gt;&lt;br&gt;question + plan / dependency summary&lt;br&gt;evidence[]: per-query modes + G citations&lt;br&gt;Unchanged output generation + SSE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
