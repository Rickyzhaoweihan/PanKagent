        <mxCell id="tK93tzaCFONGBUCUjE4C-45" value="&lt;b&gt;D7 Candidate route?&lt;/b&gt;&lt;br&gt;PYTHON dispatch / CLAUDE repair&lt;br&gt;Template, cache or GPU&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,2,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" vertex="1" parent="1" decision_engine="Python (deterministic)" decision_basis="Python chooses ordered routes using cache/template availability, path/local-coloc restrictions, configuration and the GPU-participation flag. GPU or Claude may generate/repair candidates; they do not choose this route." decision_source="graph.py: candidate route selection; candidate_policy.py" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." schema_modules="2,5,6">
