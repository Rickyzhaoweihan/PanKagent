        </mxCell>
        <mxCell id="gpu" value="&lt;b&gt;M06b • GPU Cypher API&lt;/b&gt;&lt;br&gt;Atomic task + schema + scope&lt;br&gt;Some paths allow bounded Claude repair" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0d9;strokeColor=#bd7b20;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="470" y="1550" width="400" height="130" as="geometry" />
        </mxCell>
        <mxCell id="valid" value="&lt;b&gt;D8  Common&#xa;validation passes?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#245b40&quot;&gt;&lt;b&gt;PYTHON · validation rules&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;shape=rhombus;align=center;verticalAlign=middle;spacing=5;" parent="1" vertex="1" decision_engine="Python (deterministic)" decision_basis="Python validates Cypher read-only/schema rules, required predicates, parameter authorization and dependency bindings. The candidate may be GPU-, Claude-, or template-generated, but acceptance is deterministic." decision_source="graph.py: validate_cypher; semantic_registry.py: validation_errors" tooltip="Python validates Cypher read-only/schema rules, required predicates, parameter authorization and dependency bindings. The candidate may be GPU-, Claude-, or template-generated, but acceptance is deterministic. Source: graph.py: validate_cypher; semantic_registry.py: validation_errors">
          <mxGeometry x="975" y="1450" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;M08 • Neo4j read&lt;/b&gt;&lt;br&gt;Cypher + verified parameter bindings&lt;br&gt;PanKgraph_08_04&lt;br&gt;OUT: records + provenance + completeness" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="1410" y="1450" width="400" height="180" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;Backend task outcome&lt;/b&gt;&lt;br&gt;complete / empty / partial / failed&lt;br&gt;Full IDs, nodes, edges, rows, paths&lt;br&gt;Feeds scheduler / M09; never samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="1920" y="1450" width="410" height="180" as="geometry" />
        </mxCell>
        <mxCell id="repair" value="&lt;b&gt;D9  Repair budget left?&lt;/b&gt;&lt;br&gt;Yes → regenerate / repair candidate&lt;br&gt;No → mark this task failed&lt;br&gt;Failure propagates only to dependents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ed;strokeColor=#ba5750;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
