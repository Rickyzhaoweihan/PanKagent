        <mxCell id="title" value="&lt;b&gt;PanKagent • I/O orchestration and decision points&lt;/b&gt;&lt;br&gt;Entry → entity resolution → scope/planning → execution mode → readiness → independent answer and viewer inputs&lt;br&gt;Schema consolidation candidate · 2026-09-24 · protected tabs unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=23;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
