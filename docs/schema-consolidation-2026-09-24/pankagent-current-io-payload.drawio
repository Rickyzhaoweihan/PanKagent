  <diagram name="04 Modular prompt and rule map" id="page3">
    <mxGraphModel dx="2513" dy="3035" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;PanKagent • clear module ownership and standalone registry boundary&lt;/b&gt;&lt;br&gt;Current prompt catalog is implemented; the richer capability manifest below is a design proposal, not a deployed execution registry.&lt;br&gt;Documented dev snapshot: 2026-09-23 • discovery-gate-fdfd005 • module IDs are cross-page references" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=23;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="30" y="20" width="2340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="current" value="&lt;b&gt;CURRENT • M00 shared prompt catalog&lt;/b&gt;&lt;br&gt;planning_prompt_catalog.py → MODULES + content digest&lt;br&gt;coloc_planning_guidance.py • prompts/planning/donor_samples.md&lt;br&gt;prompts/planning/modalities.json: labels + alias hints (14 modalities)&lt;br&gt;Both planning_contract.SYSTEM and llm.PLAN_SYSTEM load the modules.&lt;br&gt;Changing an alias hint alone does not implement a new query capability." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9df;strokeColor=#a58c35;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="185" width="1100" height="240" as="geometry" />
        </mxCell>
        <mxCell id="proposal" value="&lt;b&gt;PROPOSED • versioned standalone capability registry&lt;/b&gt;&lt;br&gt;Manifest: id / version / graph-release compatibility / content digest&lt;br&gt;References to separate terminology, topology, scope, template and test modules&lt;br&gt;Loader supplies applicable modules to grounding, both planners and query generation&lt;br&gt;Executable adapters validate the manifest-backed scope and result contract.&lt;br&gt;Dashed components are proposed packaging; existing source modules remain below." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9df;strokeColor=#a58c35;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
          <mxGeometry x="1270" y="185" width="1060" height="240" as="geometry" />
        </mxCell>
        <mxCell id="edge1" value="possible consolidation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52697d;strokeWidth=2;fontSize=17;fontColor=#263e52;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" parent="1" source="current" target="proposal" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="term" value="&lt;b&gt;R1 • terminology / entity resolution&lt;/b&gt;&lt;br&gt;Aliases + typed inventory owner + ambiguity policy&lt;br&gt;Example: scRNAseq → recorded modality label&lt;br&gt;Current: modalities.json / anatomy_resolution.py&lt;br&gt;Consumed by M03 grounding and M05 preparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9df;strokeColor=#a58c35;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
          <mxGeometry x="40" y="530" width="700" height="260" as="geometry" />
        </mxCell>
        <mxCell id="topology" value="&lt;b&gt;R2 • database schema / topology&lt;/b&gt;&lt;br&gt;Node/edge types; direction; property owner; roles&lt;br&gt;Coloc: Gene → disease, not Gene → SNP&lt;br&gt;Current: release_schema.py / coloc guidance&lt;br&gt;Consumed by M04 planner, M06 compiler, M07 validator" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9df;strokeColor=#a58c35;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
          <mxGeometry x="835" y="530" width="700" height="260" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;R3 • biological scope / capability&lt;/b&gt;&lt;br&gt;Source, stage, polarity, tissue and assay meaning&lt;br&gt;Multiome RNA capability requires source-specific proof&lt;br&gt;Current: semantic_registry.py / coloc_scope.py&lt;br&gt;Consumed by M05 compilation and M09 evidence join" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9df;strokeColor=#a58c35;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
          <mxGeometry x="1630" y="530" width="700" height="260" as="geometry" />
        </mxCell>
        <mxCell id="template" value="&lt;b&gt;R4 • query compiler / templates&lt;/b&gt;&lt;br&gt;Typed inputs/outputs; structural Cypher; operators&lt;br&gt;Donor IDs → HAS_SAMPLE → Sample_node&lt;br&gt;Current: query_templates.py / bounded_paths.py&lt;br&gt;Dependency roles: dependency_scope.py&lt;br&gt;Consumed by M06 dispatch + shared unit U" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9df;strokeColor=#a58c35;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
          <mxGeometry x="40" y="910" width="700" height="255" as="geometry" />
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;R5 • context / interpretation policy&lt;/b&gt;&lt;br&gt;Recorded ≠ available for download&lt;br&gt;Tissue annotation discovery ≠ tissue filter&lt;br&gt;Identity-only paths support recorded connectivity&lt;br&gt;Current: domain guidance + evidence input modules&lt;br&gt;Consumed by planning + formatter INPUT preparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9df;strokeColor=#a58c35;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
          <mxGeometry x="835" y="910" width="700" height="255" as="geometry" />
        </mxCell>
        <mxCell id="tests" value="&lt;b&gt;R6 • reference validation fixtures&lt;/b&gt;&lt;br&gt;Checked IDs/counts; exact joins; negative controls&lt;br&gt;Repeated-type paths; missing or incomplete inputs&lt;br&gt;Versioned against compatible graph releases&lt;br&gt;Registry digest invalidates affected cached plans&lt;br&gt;Required before adding a new modality capability" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9df;strokeColor=#a58c35;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;dashed=1;dashPattern=8 4;" parent="1" vertex="1">
          <mxGeometry x="1630" y="910" width="700" height="255" as="geometry" />
        </mxCell>
        <mxCell id="consumers" value="&lt;b&gt;Module consumption — decision points must use structured outputs, not prompt prose alone&lt;/b&gt;&lt;br&gt;R1 → M03 entity/value decision D1  |  R2 + R3 → M05 executable-scope decision D2  |  R4 → M06 route D7 / validator D8&lt;br&gt;R2 + R4 → scheduler parent-binding D6  |  R3 → M09 final scope / readiness D4  |  R5 → per-query input mode D10&lt;br&gt;R6 validates all affected paths. Existing Formatting Agent output logic and graph-viewer presentation stay outside this registry." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="1300" width="2290" height="170" as="geometry" />
        </mxCell>
        <mxCell id="gaps" value="&lt;b&gt;Design review priorities from the current failure cases&lt;/b&gt;&lt;br&gt;1. Preserve entity authorization: adding an operational GPU flag must not discard the T1D → canonical disease-ID proof.&lt;br&gt;2. Compile all biological scope: “pancreas splicing QTL” must become verified tissue/subtype scope, not only planning prose.&lt;br&gt;3. Carry follow-up populations: previous conversation text is not a complete typed backend-ID payload.&lt;br&gt;4. Let useful verified partial evidence proceed, while clearly distinguishing an exact answer from unmet requested conditions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0ed;strokeColor=#ba5750;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=21;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="40" y="1545" width="2290" height="190" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend / reading order&lt;/b&gt;&lt;br&gt;Solid arrows = control or data flow. Dashed arrows = policy/reference input. Diamonds = decisions. Read top to bottom.&lt;br&gt;Green: code • Purple: Claude • Orange: GPU • Teal: data • Yellow: decision • Dashed yellow: proposed registry • Red: failure/gap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="30" y="1770" width="2340" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
