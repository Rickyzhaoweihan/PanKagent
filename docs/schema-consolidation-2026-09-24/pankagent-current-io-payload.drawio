        <mxCell id="pb" value="&lt;b&gt;Q2 • independent&lt;/b&gt;&lt;br&gt;Run query unit U&lt;br&gt;Return backend R2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="420" y="370" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="pc" value="&lt;b&gt;D5  Branch outcomes?&lt;/b&gt;&lt;br&gt;Complete / empty / partial / failed&lt;br&gt;Failed sibling ≠ empty set&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#245b40&quot;&gt;&lt;b&gt;PYTHON · result statuses&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" decision_engine="Python (deterministic)" decision_basis="Python reads branch execution and validation statuses, retaining successful independent evidence and explicit failed or incomplete outcomes. No model evaluates the branch status." decision_source="composable_planning.py; evidence_status.py" tooltip="Python reads branch execution and validation statuses, retaining successful independent evidence and explicit failed or incomplete outcomes. No model evaluates the branch status. Source: composable_planning.py; evidence_status.py">
