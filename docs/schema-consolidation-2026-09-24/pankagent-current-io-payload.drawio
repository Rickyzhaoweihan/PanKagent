        <mxCell id="end" value="&lt;b&gt;All modes → M10 readiness → confirmation → M11/M12 answer input + M13 viewer input&lt;/b&gt;&lt;br&gt;Complete or meaningful verified partial evidence may proceed. Exact counts, exclusions and relationships require their own verified scope." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
          <mxGeometry x="50" y="1935" width="2300" height="95" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend / reading order&lt;/b&gt;&lt;br&gt;Solid arrows = control or data flow. Dashed arrows = policy/reference input. Diamonds = decisions. Read top to bottom.&lt;br&gt;Green: code • Purple: Claude • Orange: GPU • Teal: data • Yellow: decision • Dashed yellow: proposed registry • Red: failure/gap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f5f8;strokeColor=#8998a9;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=18;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1">
