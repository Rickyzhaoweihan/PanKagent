        <mxCell id="rev" value="&lt;b&gt;M02  Revision interpreter&lt;/b&gt;&lt;br&gt;&lt;b&gt;IN:&lt;/b&gt; previous question + change&lt;br&gt;OUT: one standalone question&lt;br&gt;Chain change: restart; parallel: extend&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,3&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#efe7fc;strokeColor=#8961b0;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="1,4" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
