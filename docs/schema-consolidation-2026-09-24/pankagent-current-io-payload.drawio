        <mxCell id="tK93tzaCFONGBUCUjE4C-48" value="&lt;b&gt;D8  Common
validation passes?&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#245b40&quot;&gt;&lt;b&gt;PYTHON · validation rules&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;font color=&quot;#ff1e1e&quot; style=&quot;font-size:14px&quot;&gt;E06: Query validation failed&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1,4&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5ee;strokeColor=#428362;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;shape=rhombus;align=center;verticalAlign=middle;spacing=5;" vertex="1" parent="1" decision_engine="Python (deterministic)" decision_basis="Python validates Cypher read-only/schema rules, required predicates, parameter authorization and dependency bindings. The candidate may be GPU-, Claude-, or template-generated, but acceptance is deterministic." decision_source="graph.py: validate_cypher; semantic_registry.py: validation_errors" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters." diagnostic_family="E06" schema_modules="2,3,6">
