        </mxCell>
        <mxCell id="ground" value="&lt;b&gt;M03  PYTHON ENTITY LOOKUP&lt;/b&gt;&lt;br&gt;Case-insensitive names + recorded synonyms&lt;br&gt;Shared verified candidates / alias provenance&lt;br&gt;Inventory and resolver use one proof store&lt;br&gt;All statuses continue; no rejection gate&lt;br&gt;&lt;font color=&quot;#B8860B&quot; style=&quot;font-size:12px&quot;&gt;&lt;b&gt;Schema 1&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f3f6;strokeColor=#347e91;strokeWidth=2;fontColor=#203344;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=18;arcSize=8;" parent="1" vertex="1" schema_modules="2,3" tooltip="Shared immutable PanKagent pack: Schema 1 database_schema.json; 2 query_patterns.json; 3 semantic_interpretation.json; 4 validation.json. Manifest pins KG standard v0.3.0 and the release digest. Observations are descriptive, never automatic filters.">
