NEO4J_SCHEMA_PATH=PankBaseAgent/text_to_cypher/data/input/neo4j_schema.json
SCHEMA_HINTS_PATH=PankBaseAgent/text_to_cypher/data/input/schema_hints.json

OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=YOUR_API_KEY_HERE
OPENAI_API_MODEL=gpt-5
OPENAI_API_TEMP=0.3
OPENAI_ASSISTANT_ID=OPTIONAL_YOUR_ASSISTANT_ID

CLAUDE_API_KEY=
# --- GPU router: SSH tunnels to the cluster vLLM fleet + load balancer ---
# The app talks to the router (VLLM_PORT) which fans out across all 5 GPUs.
SSH_USER=rickyhan
LIGHTHOUSE_HOST=lighthouse.arc-ts.umich.edu
SSH_PASSWORD=YOUR_LIGHTHOUSE_PASSWORD   # keep .env chmod 600
DUO_OPTION=1                            # "1" = Duo push to your primary device
VLLM_PORT=8010                          # app -> router
ROUTER_PORT=8010                        # router listen port (8002 is the local vLLM)
ROUTER_BACKENDS=127.0.0.1:7000:2,127.0.0.1:7001:2,127.0.0.1:7002:1,127.0.0.1:7003:1,127.0.0.1:8002:1
MAX_CONCURRENT_QUERIES=20
