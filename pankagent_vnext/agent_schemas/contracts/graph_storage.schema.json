{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Graph Storage",
  "type": "object",
  "required": [
    "schema",
    "registry",
    "relationship_guidance",
    "labels",
    "postgresql"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": {
        "id": "kg-agent.graph-storage",
        "version": "1.0.0"
      }
    },
    "registry": {
      "type": "object"
    },
    "relationship_guidance": {
      "type": "object"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postgresql": {
      "type": "object"
    }
  }
}
