{
  "type": "object",
  "required": [
    "schema",
    "limits",
    "scope_compilers",
    "invariants",
    "diagnostic_reasons",
    "backend_materialization",
    "repair_guidance"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": {
        "id": "kg-agent.validation",
        "version": "2.0.0"
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "lookup_batches",
        "requests_per_batch",
        "candidates_per_request",
        "planning_proposals",
        "execution_repairs",
        "total_claude_calls"
      ],
      "additionalProperties": false,
      "properties": {
        "lookup_batches": {
          "type": "integer"
        },
        "requests_per_batch": {
          "type": "integer"
        },
        "candidates_per_request": {
          "type": "integer"
        },
        "planning_proposals": {
          "type": "integer"
        },
        "execution_repairs": {
          "type": "integer"
        },
        "total_claude_calls": {
          "type": "integer"
        }
      }
    },
    "scope_compilers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostic_reasons": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "backend_materialization": {
      "type": "object",
      "required": [
        "max_nodes",
        "max_edges",
        "max_bytes",
        "on_exhaustion"
      ],
      "additionalProperties": false,
      "properties": {
        "max_nodes": {
          "type": "integer"
        },
        "max_edges": {
          "type": "integer"
        },
        "max_bytes": {
          "type": "integer"
        },
        "on_exhaustion": {
          "type": "string"
        }
      }
    },
    "repair_guidance": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "result_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "completed_execution",
          "materialized_endpoints"
        ]
      }
    },
    "structural_budget_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "graph_release",
          "basis",
          "route_kind",
          "version",
          "shapes",
          "weights"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "graph_release": {
            "type": "string"
          },
          "basis": {
            "type": "string"
          },
          "route_kind": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "shapes": {
            "type": "object"
          },
          "weights": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "template_warning_exceptions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "warnings",
          "basis"
        ],
        "properties": {
          "warnings": {
            "type": "array",
            "items": {
              "enum": [
                "schema_or_plan_warning:CartesianProduct"
              ]
            }
          },
          "basis": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
