{
  "schema": {
    "id": "kg-agent.identity",
    "version": "1.0.0"
  },
  "public_labels": [
    "Gene",
    "anatomical_structure",
    "disease",
    "GO_term",
    "kegg",
    "reactome",
    "data_modality"
  ],
  "index_name": "pankagent_public_entities_v1",
  "id_field": "id",
  "name_fields": [
    "name",
    "hgnc_symbol",
    "hgnc_id"
  ],
  "synonym_field": "synonyms",
  "lookup_order": [
    "exact_id",
    "casefold_name",
    "recorded_synonym",
    "indexed_fuzzy"
  ],
  "max_candidates": 10,
  "fuzzy_selection": "contextual_model_choice",
  "case_variants_require_clarification": false,
  "exact_only_labels": [
    "variants"
  ],
  "session_references": [
    {
      "entity_type": "donor",
      "mention_pattern": "\\b(?:these|those|the previously (?:identified|returned))\\s+donors\\b",
      "query_relations": [
        "HAS_SAMPLE"
      ]
    }
  ]
}
